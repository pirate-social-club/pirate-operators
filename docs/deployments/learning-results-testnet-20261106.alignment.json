      },
      {
        "lineId": "0x4b7f35ab4b7438c7c4d547a8ce1c609b876e4072cedda447e7db04157942eab4",
        "lineVersion": 1,
        "ordinal": 18,
        "text": "'Cause when the band starts jazzin', play 'em 'til the sergeant comes",
        "startMs": 117700,
        "endMs": 124800,
        "words": [
          {
            "text": "'Cause",
            "startMs": 117700,
            "endMs": 118480
          },
          {
            "text": "when",
            "startMs": 118540,
            "endMs": 118660
          },
          {
            "text": "the",
            "startMs": 118700,
            "endMs": 118760
          },
          {
            "text": "band",
            "startMs": 118880,
            "endMs": 119240
          },
          {
            "text": "starts",
            "startMs": 119400,
            "endMs": 120040
          },
          {
            "text": "jazzin',",
            "startMs": 120160,
            "endMs": 120800
          },
          {
            "text": "play",
            "startMs": 121180,
            "endMs": 121480
          },
          {
            "text": "'em",
            "startMs": 121500,
            "endMs": 121640
          },
          {
            "text": "'til",
            "startMs": 121700,
            "endMs": 122040
          },
          {
            "text": "the",
            "startMs": 122100,
            "endMs": 122140
          },
          {
            "text": "sergeant",
            "startMs": 122300,
            "endMs": 123560
          },
          {
            "text": "comes",
            "startMs": 123720,
            "endMs": 124800
          }
        ]
      },
      {
        "lineId": "0xf4cae3e9291ac4a19623a4f3f26ec4090cb219052769ee51bcdf03c10c8c3fa2",
        "lineVersion": 1,
        "ordinal": 19,
        "text": "Now wouldn't that good music drive you insane?",
        "startMs": 153820,
        "endMs": 156800,
        "words": [
          {
            "text": "Now",
            "startMs": 153820,
            "endMs": 154000
          },
          {
            "text": "wouldn't",
            "startMs": 154100,
            "endMs": 154340
          },
          {
            "text": "that",
            "startMs": 154400,
            "endMs": 154540
          },
          {
            "text": "good",
            "startMs": 154660,
            "endMs": 154820
          },
          {
            "text": "music",
            "startMs": 154920,
            "endMs": 155280
          },
          {
            "text": "drive",
            "startMs": 155360,
            "endMs": 155740
          },
          {
            "text": "you",
            "startMs": 155800,
            "endMs": 155900
          },
          {
            "text": "insane?",
            "startMs": 155960,
            "endMs": 156800
          }
        ]
      },
      {
        "lineId": "0x791293dea8099dfa5a24cef22fd453d401be326f3320234fa764a58ece062829",
        "lineVersion": 1,
        "ordinal": 20,
        "text": "There's nothin' to them but that blue refrain",
        "startMs": 158120,
        "endMs": 161760,
        "words": [
          {
            "text": "There's",
            "startMs": 158120,
            "endMs": 158420
          },
          {
            "text": "nothin'",
            "startMs": 158460,
            "endMs": 158700
          },
          {
            "text": "to",
            "startMs": 158840,
            "endMs": 159000
          },
          {
            "text": "them",
            "startMs": 159060,
            "endMs": 159220
          },
          {
            "text": "but",
            "startMs": 159300,
            "endMs": 159520
          },
          {
            "text": "that",
            "startMs": 159580,
            "endMs": 159900
          },
          {
            "text": "blue",
            "startMs": 160300,
            "endMs": 160520
          },
          {
            "text": "refrain",
            "startMs": 160600,
            "endMs": 161760
          }
        ]
      },
      {
        "lineId": "0x85446361d93fa15f521cfc39df2ffd86d277628dc0bd476820c681acfcb96f6f",
        "lineVersion": 1,
        "ordinal": 21,
        "text": "When that cornet and flute begin to play",
        "startMs": 162400,
        "endMs": 164980,
        "words": [
          {
            "text": "When",
            "startMs": 162400,
            "endMs": 162620
          },
          {
            "text": "that",
            "startMs": 162680,
            "endMs": 162800
          },
          {
            "text": "cornet",
            "startMs": 162920,
            "endMs": 163380
          },
          {
            "text": "and",
            "startMs": 163420,
            "endMs": 163500
          },
          {
            "text": "flute",
            "startMs": 163600,
            "endMs": 163820
          },
          {
            "text": "begin",
            "startMs": 163880,
            "endMs": 164260
          },
          {
            "text": "to",
            "startMs": 164300,
            "endMs": 164440
          },
          {
            "text": "play",
            "startMs": 164500,
            "endMs": 164980
          }
        ]
      },
      {
        "lineId": "0xd9403fc952ac05bc1fcb64eb7a2101409900bc0509e4a87cebd07f8e6b9e7a9d",
        "lineVersion": 1,
        "ordinal": 22,
        "text": "Oh, it makes me get up and throw my little self away",
        "startMs": 165680,
        "endMs": 169020,
        "words": [
          {
            "text": "Oh,",
            "startMs": 165680,
            "endMs": 166020
          },
          {
            "text": "it",
            "startMs": 166160,
            "endMs": 166280
          },
          {
            "text": "makes",
            "startMs": 166340,
            "endMs": 166580
          },
          {
            "text": "me",
            "startMs": 166620,
            "endMs": 166700
          },
          {
            "text": "get",
            "startMs": 166800,
            "endMs": 166940
          },
          {
            "text": "up",
            "startMs": 167000,
            "endMs": 167080
          },
          {
            "text": "and",
            "startMs": 167120,
            "endMs": 167180
          },
          {
            "text": "throw",
            "startMs": 167260,
            "endMs": 167520
          },
          {
            "text": "my",
            "startMs": 167580,
            "endMs": 167760
          },
          {
            "text": "little",
            "startMs": 167820,
            "endMs": 168040
          },
          {
            "text": "self",
            "startMs": 168220,
            "endMs": 168500
          },
          {
            "text": "away",
            "startMs": 168580,
            "endMs": 169020
          }
        ]
      },
      {
        "lineId": "0xab092a88239634086fb95d0c6c2e61436b5fe3973ad27e3fdaf2ac11a43b43b9",
        "lineVersion": 1,
        "ordinal": 23,
        "text": "Just play those good old jazzin' baby blues all night and day",
        "startMs": 169740,
        "endMs": 174980,
        "words": [
          {
            "text": "Just",
            "startMs": 169740,
            "endMs": 169920
          },
          {
            "text": "play",
            "startMs": 169960,
            "endMs": 170180
          },
          {
            "text": "those",
            "startMs": 170240,
            "endMs": 170420
          },
          {
            "text": "good",
            "startMs": 170520,
            "endMs": 170660
          },
          {
            "text": "old",
            "startMs": 170720,
            "endMs": 171440
          },
          {
            "text": "jazzin'",
            "startMs": 171580,
            "endMs": 172020
          },
          {
            "text": "baby",
            "startMs": 172620,
            "endMs": 172900
          },
          {
            "text": "blues",
            "startMs": 172980,
            "endMs": 173480
          },
          {
            "text": "all",
            "startMs": 173560,
            "endMs": 173860
          },
          {
            "text": "night",
            "startMs": 173960,
            "endMs": 174240
          },
          {
            "text": "and",
            "startMs": 174300,
            "endMs": 174500
          },
          {
            "text": "day",
            "startMs": 174600,
            "endMs": 174980
          }
        ]
      }

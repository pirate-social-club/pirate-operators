{
  "name": "@pirate/community-wizard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "start": "tsx server/start.ts",
    "start:operator": "node --import tsx server/start-operator.ts",
    "check": "tsc --noEmit && tsx --test test/*.test.ts && npm run build",
    "test:browser": "node test/run-browser.mjs",
    "diagnostic": "tsx server/read-diagnostic.ts",
    "smoke:runtime": "tsx test/runtime-smoke.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-node": "4.1.2",
    "@infisical/sdk": "5.0.2",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "solid-js": "1.9.18",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.8"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "7.29.7",
    "zod": "4.6.7"
  }
}

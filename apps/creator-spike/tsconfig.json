{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client"]
  },
  "include": ["src", "test", "scripts/*.ts", "vite.config.ts"]
}

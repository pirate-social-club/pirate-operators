  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.ts",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "check:reproducible": "node scripts/reproducible.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run build:live && npm run test:e2e && npm run test:e2e:live && npm run test:e2e:wallet",
    "build:live": "vite build --config vite.live.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:wallet": "vite build --config test/reward-wallet.vite.config.ts && playwright test --config test/reward-wallet.playwright.config.ts"
  },

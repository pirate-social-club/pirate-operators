{
  "name": "pirate-operators",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "acceptance": "node harness/acceptance.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && forge test --offline && npm run acceptance",
    "dev": "cf dev",
    "build": "cf build",
    "testnet:prepare": "node harness/testnet/acceptance.ts prepare",
    "testnet:tempo": "node harness/testnet/acceptance.ts tempo",
    "testnet:base": "node harness/testnet/acceptance.ts base",
    "testnet:e2e": "node harness/testnet/acceptance.ts e2e",
    "testnet:verify": "node harness/testnet/acceptance.ts verify"
  },
  "dependencies": {
    "mppx": "0.17.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@cloudflare/workers-types": "5.20261103.1",
    "@types/node": "24.19.2",
    "cf": "1.0.0-beta.19",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "tmp": "0.2.7",
    "zod": "4.6.7"
  }
}

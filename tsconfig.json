{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "packages/**/*.ts",
    "services/**/*.ts",
    "harness/**/*.ts",
    "test/**/*.ts"
  ]
}
